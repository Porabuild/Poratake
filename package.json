{
  "name": "poratake",
  "private": true,
  "version": "1.0.6",
  "description": "Capture, annotate, record, edit, and share on macOS, Windows, and Linux.",
  "author": "Serhii Vecherenko",
  "homepage": "https://porabuild.com/poratake",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Porabuild/Poratake.git"
  },
  "bugs": {
    "url": "https://github.com/Porabuild/Poratake/issues"
  },
  "packageManager": "bun@1.4.0",
  "license": "AGPL-3.0-only",
  "overrides": {
    "vite": "8.2.1"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "bun scripts/dev-gpui.mjs",
    "dev:gpui": "bun scripts/dev-gpui.mjs",
    "build:gpui:mac": "bun run build-native-mac && bash scripts/build-gpui-mac.sh",
    "package:gpui:mac": "bash scripts/package-gpui-mac.sh",
    "package:gpui:win": "node scripts/package-gpui-win.mjs",
    "build:gpui:linux": "bun run check:daemon-contract && cargo build --release --locked --manifest-path src/main/Cargo.toml --package poratake-daemon-linux --package poratake-gpui",
    "package:gpui:linux": "bash scripts/package-gpui-linux.sh",
    "build-daemon-win": "powershell -ExecutionPolicy Bypass -File scripts/build-daemon-win.ps1",
    "build-ffmpeg-win": "powershell -ExecutionPolicy Bypass -File scripts/build-ffmpeg-win.ps1",
    "build-whisper-win": "powershell -ExecutionPolicy Bypass -File scripts/build-whisper-win.ps1",
    "build-native-win": "bun run build-daemon-win && bun run build-ffmpeg-win && bun run build-whisper-win",
    "build-native-mac": "./scripts/build-daemon.sh && ./scripts/build-ffmpeg.sh && ./scripts/build-whisper.sh",
    "generate:daemon-contract": "bun scripts/generate-daemon-contract.mjs",
    "check:daemon-contract": "bun scripts/generate-daemon-contract.mjs --check",
    "lint": "oxlint . --report-unused-disable-directives --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:daemon-win": "bun scripts/check-daemon-win.mjs",
    "test:visual": "bun scripts/parity/visual.mjs",
    "checks": "bun run check:daemon-contract && bun run lint && bun run format:check && bun run test && bun run test:daemon-win"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "oxfmt": "^0.64.0",
    "oxlint": "1.79.0",
    "vitest": "^4.1.11"
  }
}
