{
  "name": "poratake",
  "private": true,
  "version": "1.14.0",
  "description": "Capture, annotate, record, edit, and share on macOS and Windows.",
  "author": "Serhii Vecherenko",
  "homepage": "https://porabuild.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Porabuild/Poratake.git"
  },
  "bugs": {
    "url": "https://github.com/Porabuild/Poratake/issues"
  },
  "packageManager": "bun@1.3.8",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build-mac": "bun run build-native-mac && rm -rf ./dist && rm -rf ./dist-electron && tsc && vite build && electron-builder --mac --universal -p never",
    "build-mac:local": "bun run build-native-mac && rm -rf ./dist && rm -rf ./dist-electron && tsc && vite build && electron-builder --mac --universal -c.mac.identity=null -p never",
    "build-win": "bun run build-native-win && node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('dist-electron',{recursive:true,force:true})\" && tsc && vite build && electron-builder --win -p never",
    "build-daemon-win": "powershell -ExecutionPolicy Bypass -File scripts/build-daemon-win.ps1",
    "build-ffmpeg-win": "powershell -ExecutionPolicy Bypass -File scripts/build-ffmpeg-win.ps1",
    "build-whisper-win": "powershell -ExecutionPolicy Bypass -File scripts/build-whisper-win.ps1",
    "build-native-win": "bun run build-daemon-win && bun run build-ffmpeg-win && bun run build-whisper-win",
    "build-native-mac": "./scripts/build-daemon.sh && ./scripts/build-ffmpeg.sh && ./scripts/build-whisper.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:daemon-win": "node scripts/check-daemon-win.mjs",
    "checks": "bun run typecheck && bun run lint && bun run format:check && bun run test:run && bun run test:daemon-win"
  },
  "dependencies": {
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.560.0",
    "mediabunny": "^1.52.3",
    "perfect-freehand": "^1.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "happy-dom": "^20.11.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vitest": "^4.1.10"
  },
  "main": "dist-electron/main.js"
}
