{
  "name": "poratake",
  "private": true,
  "version": "0.9.0",
  "description": "Capture, annotate, record, edit, and share on macOS and Windows.",
  "author": "Serhii Vecherenko",
  "homepage": "https://porabuild.com/poratake",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Porabuild/Poratake.git"
  },
  "bugs": {
    "url": "https://github.com/Porabuild/Poratake/issues"
  },
  "packageManager": "bun@1.3.14",
  "license": "AGPL-3.0-only",
  "overrides": {
    "builder-util-runtime": "9.7.0",
    "form-data": "4.0.6",
    "nanoid": "3.3.18",
    "picomatch": "4.0.5",
    "postcss": "8.5.26",
    "tmp": "0.2.7",
    "vite": "8.2.1"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "node scripts/dev.mjs",
    "build-mac": "bun run build-native-mac && bun run package-mac",
    "package-mac": "rm -rf ./dist && rm -rf ./dist-electron && tsc && vite build && electron-builder --mac --universal -p never",
    "build-mac:local": "bun run build-native-mac && rm -rf ./dist && rm -rf ./dist-electron && tsc && vite build && electron-builder --mac --universal -c.mac.identity=null -p never",
    "build-win": "bun run build-native-win && node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('dist-electron',{recursive:true,force:true})\" && tsc && vite build && node scripts/package-win.mjs",
    "build-daemon-win": "powershell -ExecutionPolicy Bypass -File scripts/build-daemon-win.ps1",
    "build-ffmpeg-win": "powershell -ExecutionPolicy Bypass -File scripts/build-ffmpeg-win.ps1",
    "build-whisper-win": "powershell -ExecutionPolicy Bypass -File scripts/build-whisper-win.ps1",
    "build-native-win": "bun run build-daemon-win && bun run build-ffmpeg-win && bun run build-whisper-win",
    "build-native-mac": "./scripts/build-daemon.sh && ./scripts/build-ffmpeg.sh && ./scripts/build-whisper.sh",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . --report-unused-disable-directives --deny-warnings",
    "preview": "vite preview",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:daemon-win": "node scripts/check-daemon-win.mjs",
    "checks": "bun run typecheck && bun run lint && bun run format:check && bun run test:run && bun run test:daemon-win"
  },
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.32.0",
    "mediabunny": "^1.55.1",
    "perfect-freehand": "^1.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "happy-dom": "^20.11.2",
    "oxfmt": "^0.64.0",
    "oxlint": "1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.2.1",
    "vite-plugin-electron": "1.1.1",
    "vitest": "^4.1.11"
  },
  "main": "dist-electron/main.js"
}
