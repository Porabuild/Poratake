// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.porabuild.poratake",
  "asar": true,
  "productName": "Poratake",
  "copyright": "Copyright © 2026 Serhii Vecherenko. Based on Capty, Copyright © 2026 Capty.",
  "directories": {
    "output": "release/${version}"
  },
  "extraResources": [
    "build/*",
    {
      "from": "LICENSE",
      "to": "licenses/Poratake-AGPL-3.0.txt"
    },
    {
      "from": "THIRD_PARTY_NOTICES.md",
      "to": "licenses/THIRD_PARTY_NOTICES.md"
    },
    {
      "from": "licenses/FFmpeg-LGPL-2.1.txt",
      "to": "licenses/FFmpeg-LGPL-2.1.txt"
    },
    {
      "from": "licenses/Geist-OFL-1.1.txt",
      "to": "licenses/Geist-OFL-1.1.txt"
    },
    {
      "from": "node_modules",
      "to": "licenses/node_modules",
      "filter": [
        "@heroui/**/LICENSE*",
        "@internationalized/**/LICENSE*",
        "@react-aria/**/LICENSE*",
        "@react-stately/**/LICENSE*",
        "@react-types/**/LICENSE*",
        "@radix-ui/**/LICENSE*",
        "@floating-ui/**/LICENSE*",
        "aria-hidden/LICENSE*",
        "builder-util-runtime/LICENSE*",
        "clsx/license*",
        "debug/LICENSE*",
        "detect-node-es/LICENSE*",
        "electron-updater/LICENSE*",
        "fs-extra/LICENSE*",
        "get-nonce/LICENSE*",
        "graceful-fs/LICENSE*",
        "js-yaml/LICENSE*",
        "jsonfile/LICENSE*",
        "lodash.escaperegexp/LICENSE*",
        "lodash.isequal/LICENSE*",
        "lucide-react/LICENSE*",
        "mediabunny/LICENSE*",
        "ms/license*",
        "perfect-freehand/LICENSE*",
        "react/LICENSE*",
        "react-aria/LICENSE*",
        "react-aria-components/LICENSE*",
        "react-dom/LICENSE*",
        "react-remove-scroll/LICENSE*",
        "react-stately/LICENSE*",
        "react-style-singleton/LICENSE*",
        "sax/LICENSE*",
        "scheduler/LICENSE*",
        "semver/LICENSE*",
        "tailwind-merge/LICENSE*",
        "tailwind-variants/LICENSE*",
        "tiny-typed-emitter/LICENSE*",
        "tslib/LICENSE*",
        "tw-animate-css/LICENSE*",
        "universalify/LICENSE*",
        "use-callback-ref/LICENSE*",
        "use-sidecar/LICENSE*",
        "use-sync-external-store/LICENSE*"
      ]
    },
    {
      "from": "licenses/npm",
      "to": "licenses/npm"
    },
    {
      "from": "src/main/menu/icons",
      "to": "menu-icons"
    },
    {
      "from": "src/main/menu/iconTemplate.png",
      "to": "menu-icons/iconTemplate.png"
    },
    {
      "from": "src/main/menu/iconTemplate@2x.png",
      "to": "menu-icons/iconTemplate@2x.png"
    },
    {
      "from": "src/main/menu/iconTemplate@3x.png",
      "to": "menu-icons/iconTemplate@3x.png"
    },
    {
      "from": "src/main/menu/recording/iconTemplate.png",
      "to": "menu-icons/recording/iconTemplate.png"
    },
    {
      "from": "src/main/menu/recording/iconTemplate@2x.png",
      "to": "menu-icons/recording/iconTemplate@2x.png"
    },
    {
      "from": "src/main/menu/recording/iconTemplate@3x.png",
      "to": "menu-icons/recording/iconTemplate@3x.png"
    },
    {
      "from": "public/sounds",
      "to": "sounds"
    },
    {
      "from": "public/icon.png",
      "to": "icon.png"
    },
    {
      "from": "public/tray-icon.png",
      "to": "tray-icon.png"
    }
  ],
  "files": [
    "dist",
    "dist-electron",
    "!node_modules/**"
  ],
  "publish": {
    "provider": "github",
    "owner": "Porabuild",
    "repo": "Poratake",
    "private": false
  },
  "extraFiles": [
    "build/**/*"
  ],
  "mac": {
    "extraResources": [
      {
        "from": "src/main/daemon/capty-daemon",
        "to": "daemon/capty-daemon"
      },
      {
        "from": "src/main/binaries/ffmpeg/ffmpeg",
        "to": "binaries/ffmpeg/ffmpeg"
      },
      {
        "from": "src/main/binaries/whisper/whisper",
        "to": "binaries/whisper/whisper"
      }
    ],
    "extendInfo": {
      "LSUIElement": true,
      "NSMicrophoneUsageDescription": "Poratake needs microphone access to record voice audio along with screen recordings.",
      "NSCameraUsageDescription": "Poratake needs camera access to record video from your camera.",
      "NSCameraUseContinuityCameraDeviceType": true,
      "CFBundleDocumentTypes": [
        {
          "CFBundleTypeName": "Poratake Recording",
          "CFBundleTypeExtensions": ["capty"],
          "CFBundleTypeRole": "Editor",
          "LSHandlerRank": "Owner",
          "LSTypeIsPackage": true
        },
        {
          "CFBundleTypeName": "Image",
          "CFBundleTypeExtensions": [
            "png",
            "jpg",
            "jpeg",
            "gif",
            "webp",
            "bmp",
            "tiff"
          ],
          "CFBundleTypeRole": "Editor",
          "LSHandlerRank": "Alternate",
          "LSItemContentTypes": [
            "public.png",
            "public.jpeg",
            "public.gif",
            "com.compuserve.gif",
            "org.webmproject.webp",
            "com.microsoft.bmp",
            "public.tiff"
          ]
        }
      ],
      "UTExportedTypeDeclarations": [
        {
          "UTTypeIdentifier": "com.porabuild.poratake.recording",
          "UTTypeConformsTo": ["public.package", "public.composite-content"],
          "UTTypeDescription": "Poratake Recording Project",
          "UTTypeTagSpecification": {
            "public.filename-extension": ["capty"]
          }
        }
      ]
    },
    "darkModeSupport": true,
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mac.dist",
    "entitlementsInherit": "build/entitlements.mac.dist",
    "notarize": true,
    "x64ArchFiles": "Contents/Resources/{native,binaries,daemon}/**/*"
  },
  "dmg": {
    "title": "${productName} ${version}",
    "icon": "./build/icon.icns",
    "sign": false
  },
  "win": {
    "target": [
      {
        "target": "nsis"
      }
    ],
    "icon": "build/icon.ico",
    "artifactName": "${productName}-${version}-win-${arch}.${ext}",
    "extraResources": [
      {
        "from": "src/main/daemon/capty-daemon.exe",
        "to": "daemon/capty-daemon.exe"
      },
      {
        "from": "src/main/binaries/ffmpeg/ffmpeg.exe",
        "to": "binaries/ffmpeg/ffmpeg.exe"
      },
      {
        "from": "src/main/binaries/whisper/whisper.exe",
        "to": "binaries/whisper/whisper.exe"
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  }
}
