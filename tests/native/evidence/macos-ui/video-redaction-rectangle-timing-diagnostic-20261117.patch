+#[test]
+#[ignore]
+fn rectangle_crop_composition_timing_probe() {
+    use crate::editor::annotations::Annotation;
+    use crate::windows::video_editor::model::DrawingSegment;
+    use std::time::Instant;
+    let video = source(3840, 2160, Color::from_rgba8(32, 64, 128, 255));
+    let frames = Frames { video: Some(video.as_ref()), camera: None };
+    for include_rectangle in [false, true] {
+        let mut annotations = Vec::new();
+        if include_rectangle {
+            annotations.push(Annotation::Rectangle { id: "rectangle".into(), x: 0.0, y: 0.0, width: 3840.0, height: 2160.0, stroke: "#ffffff".into(), stroke_width: 4.0, fill: None });
+        }
+        annotations.push(Annotation::Redact { id: "redact".into(), x: 1000.0, y: 0.0, width: 320.0, height: 240.0, style: "pixelate".into(), intensity: 5.0 });
+        let mut state = state();
+        state.drawing_segments.push(DrawingSegment { id: "drawing".into(), start_time: 0.0, end_time: 3.0, canvas_width: 3840.0, canvas_height: 2160.0, annotations });
+        let mut engine = Engine::new(Config::new(3840.0, 2160.0, state));
+        let mut times = Vec::new();
+        for _ in 0..7 {
+            let start = Instant::now();
+            engine.render_frame_scaled(1.0, frames, 960, 540).unwrap();
+            times.push(start.elapsed().as_secs_f64() * 1000.0);
+        }
+        times.remove(0);
+        times.sort_by(f64::total_cmp);
+        println!("rectangle={include_rectangle}: upper median {:.2} ms", times[3]);
+    }
+}
