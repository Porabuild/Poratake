{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "trailingComma": "es5",
  "singleQuote": true,
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "build",
    "src/main/target",
    "src/main/Cargo.lock",
    "vendor/gpui-pre",
    "vendor/gpui-pre-apple",
    "vendor/gpui-pre-macos",
    "vendor/gpui-pre-windows",
    "vendor/rfd",
    "bun.lock",
    "*.log",
    ".DS_Store",
    "coverage",
    "CLAUDE.md"
  ]
}
